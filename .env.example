# AZMG GPAO : variables d'environnement.
# Copier en .env (hors du dossier public) et completer. Toute variable absente fait basculer
# l'integration correspondante en mode simule : l'application fonctionne, le manque est liste
# dans docs/A_FOURNIR.md.

# --- Execution -------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Derriere le proxy d'o2switch, mettre a 1 en production.
TRUST_PROXY=0
# Niveau de journal : debug, info, warn, error.
LOG_LEVEL=info

# --- Base de donnees -------------------------------------------------------
# Production o2switch : base dediee azmg_gpao, PostgreSQL 9.6.
DATABASE_URL=postgresql://azmg:azmg@localhost:5432/azmg_gpao_dev
DATABASE_SSL=0
# Bases utilisees par les tests et par les parcours Playwright.
DATABASE_URL_TEST=postgresql://azmg:azmg@localhost:5432/azmg_gpao_test
DATABASE_URL_E2E=postgresql://azmg:azmg@localhost:5432/azmg_gpao_e2e

# --- Securite --------------------------------------------------------------
# OBLIGATOIRE en production, 32 caracteres minimum. Exemple de generation :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=secret-de-developpement-a-changer-absolument

# --- Adresses --------------------------------------------------------------
APP_URL=http://localhost:3000
# Production : https://gpao.intranet.azmg-solutions.com

# --- Fichiers --------------------------------------------------------------
# Dossier de stockage des pieces, HORS du dossier public.
STORAGE_DIR=storage
# Taille maximale d'un classeur importe, en octets.
IMPORT_MAX_BYTES=15728640

# --- IA integree (phase 3) -------------------------------------------------
# agent : aucun cout API, les taches sont traitees par une routine Claude Code.
# api   : appel direct de l'API Anthropic (necessite ANTHROPIC_API_KEY).
# mock  : reponses simulees (developpement et tests).
AI_PROVIDER=mock
AGENT_API_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=
ANTHROPIC_MODEL_SMART=
AI_TIMEOUT_MS=90000

# --- Connecteur Claude, MCP (phase 2) --------------------------------------
# Cle de 32 caracteres minimum, sinon /mcp reste ferme.
AZMG_MCP_TOKEN=
# Email de l'utilisateur au nom duquel le connecteur agit dans le journal d'actions.
AZMG_MCP_UTILISATEUR=

# --- Collecte des mails du poste (phase 4) ---------------------------------
# apps_script : webhook signe appele par un script Google Apps Script sur la boite de suivi.
# imap        : relevage IMAP direct.
# mock        : aucune collecte (la GPAO vit de la saisie rapide et de l'import).
COLLECTE_MAIL=mock
APPS_SCRIPT_SECRET=
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=1
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# --- Envoi des emails ------------------------------------------------------
# Notifications internes et reinitialisation de mot de passe uniquement.
# Aucun mail ne part automatiquement vers un client, un transitaire ou la DO.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AZMG GPAO <gpao@azmg-solutions.com>

# --- Alertes et taches planifiees ------------------------------------------
# Destinataire des alertes de deploiement et d'incident.
ALERT_EMAIL=
# Developpement uniquement : simule le cron dans le processus. En production, cron cPanel.
CRON_INPROCESS=0
# Donnees de demonstration autorisees (jamais en production).
SEED_DEMO=1
