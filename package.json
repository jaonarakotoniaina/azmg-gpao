{
  "name": "azmg-gpao",
  "version": "1.0.0",
  "private": true,
  "description": "GPAO AZMG-Solutions : pilotage operationnel des postes places chez les clients",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsx scripts/build-server.ts",
    "start": "node app.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/server/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env src/server/cli.ts seed",
    "cron": "tsx --env-file-if-exists=.env src/server/cron.ts",
    "cli": "tsx --env-file-if-exists=.env src/server/cli.ts",
    "eval": "tsx src/server/ai/evals/run.ts"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cookie": "^1.1.1",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "hash-wasm": "^4.12.0",
    "helmet": "^8.3.0",
    "imapflow": "^2.11.0",
    "luxon": "^3.7.2",
    "mailparser": "^3.14.2",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "@tanstack/react-query": "^5.104.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.5",
    "@types/mailparser": "^3.9.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "lucide-react": "^1.48.0",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "supertest": "^7.3.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
